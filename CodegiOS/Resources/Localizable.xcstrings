          }
        }
      }
    },
    "This session is open elsewhere. If another %@ client (the app, the CLI or an IDE extension) has it, close it there or quit that client, then reload. If you just forked it, reload in about a minute." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
