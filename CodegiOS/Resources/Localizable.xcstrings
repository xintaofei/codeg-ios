    },
    "Cursor runs commands without asking. Deny rules below still apply." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor 执行命令时不再询问，下方的拒绝规则仍然生效。"
